{
  "name": "Mazda3 Fill-Up Logger",
  "short_name": "Fill-Up",
  "description": "Log a fuel fill-up from a receipt and dashboard photo.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#14110f",
